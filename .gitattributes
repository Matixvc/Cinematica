# Git LFS - Unreal Engine 5.6.1 Configuration
# See https://git-lfs.github.io/

# Unreal Engine Asset Files - Track with Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# Level Sequence files
*.seq filter=lfs diff=lfs merge=lfs -text
*.uasset.filter filter=lfs diff=lfs merge=lfs -text
*.uasset.metadata filter=lfs diff=lfs merge=lfs -text

# Static Mesh files
*.fbx filter=lfs diff=lfs merge=lfs -text

# Animation Blueprints and related
*.animfilter=lfs diff=lfs merge=lfs -text

# Material files
*.matsfilter=lfs diff=lfs merge=lfs -text

# Texture files
*.texfilter=lfs diff=lfs merge=lfs -text

# Audio files
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text

# Animation Runtime data
*.animrawfilter=lfs diff=lfs merge=lfs -text

# Blueprint files
*.uplfilter=lfs diff=lfs merge=lfs -text

# World Partition
*.wpfilter=lfs diff=lfs merge=lfs -text

# Bridge/External tool files
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text

# Keep Binaries, Intermediate, and DerivedDataCache out of LFS (they should be gitignored)
/Binaries/
/Intermediate/
/DerivedDataCache/

# But track specific binary files that need LFS if they exist and are needed
# Generic binary tracking - only uncomment if needed
# *.dll filter=lfs diff=lfs merge=lfs -text
# *.exe filter=lfs diff=lfs merge=lfs -text